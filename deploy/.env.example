# Adresse publique de Cairn
CAIRN_DOMAIN=cairn.antoinequarroz.ch

# Adresse de l'hôte sur laquelle Cairn écoute. 172.17.0.1 est le pont Docker :
# joignable par le Caddy de Metricove, mais pas depuis Internet.
CAIRN_BIND=172.17.0.1
CAIRN_PORT=3020

# Sauvegardes chiffrées (deploy/backup.sh, voir docs/DEPLOIEMENT.md étape 5)
# Clé publique age « age1… ». La clé privée reste hors du VPS.
CAIRN_BACKUP_RECIPIENTS=
# Destination rclone hors du VPS, ex. storagebox:cairn. Vide : sur le VPS seulement.
CAIRN_BACKUP_REMOTE=
CAIRN_BACKUP_KEEP_DAYS=30
