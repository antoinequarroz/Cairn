# Adresse publique de Cairn
CAIRN_DOMAIN=cairn.postmelo.ch

# Sans docker-compose.override.yml (serveur sans Caddy partagé) : adresse de l'hôte sur laquelle
# Cairn écoute. 172.17.0.1 est le pont Docker : joignable par un proxy local, pas depuis Internet.
CAIRN_BIND=172.17.0.1
CAIRN_PORT=3020

# Sauvegardes chiffrées (deploy/backup.sh, voir docs/DEPLOIEMENT.md étape 5)
# Clé publique age « age1… ». La clé privée reste hors du VPS.
CAIRN_BACKUP_RECIPIENTS=
# Destination rclone hors du VPS, ex. swissbackup:cairn (Infomaniak Swiss Backup). Vide : sur le VPS seulement.
CAIRN_BACKUP_REMOTE=
CAIRN_BACKUP_KEEP_DAYS=30
