# Adresse publique de Cairn
CAIRN_DOMAIN=cairn.antoinequarroz.ch

# Sans docker-compose.override.yml (serveur sans Caddy partagé) : adresse de l'hôte sur laquelle
# Cairn écoute. 172.17.0.1 est le pont Docker : joignable par un proxy local, pas depuis Internet.
CAIRN_BIND=172.17.0.1
CAIRN_PORT=3020
