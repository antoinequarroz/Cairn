# Mot de passe pour accéder à l'app. Obligatoire en ligne : sans lui, Cairn refuse de démarrer en production.
# Il se change ensuite dans Réglages (le nouveau est gardé, haché, dans data/auth.json).
APP_PASSWORD=

# Jeton pour les scripts (Hermes, Claude Code) : header "Authorization: Bearer <API_TOKEN>" sur /api.
# Donne accès aux notes et aux fichiers, jamais au coffre.   openssl rand -hex 32
API_TOKEN=

# Dossier de la base SQLite et des fichiers joints
DATA_DIR=./data

# Taille maximale d'un fichier joint, en Mo
MAX_FILE_MB=500

# Clé qui chiffre les secrets saisis dans Réglages (clés d'IA). Facultative : sans elle, Cairn crée
# data/secret.key. La mettre ici la garde hors des sauvegardes.   openssl rand -hex 32
CAIRN_SECRET=

# --- IA : le bouton « IA » de l'éditeur (voir docs/IA.md) ---
# Le plus simple : Réglages > IA dans l'app (abonnement Claude ou ChatGPT, ou clé d'API).
# Ce qui suit sert de repli : ce qui est saisi dans Réglages passe avant.
# Sans rien ci-dessous, le bouton reste là et explique comment l'activer.
# Un seul fournisseur suffit. S'il y en a plusieurs, Cairn prend le premier dans l'ordre
# hermes, anthropic, openai, claude-code, codex. Pour en imposer un : AI_PROVIDER=<l'un d'eux>
AI_PROVIDER=

# 1. Hermes, ton agent sur le VPS (comme Metricove). La clé est l'API_SERVER_KEY de Hermes.
HERMES_URL=
HERMES_API_KEY=
# Nom du modèle envoyé à Hermes (hermes-agent par défaut)
HERMES_MODEL=

# 2. API d'Anthropic (Claude). Une clé d'API de console.anthropic.com, pas un abonnement Claude.
ANTHROPIC_API_KEY=
# Modèle (claude-opus-5-5 par défaut ; claude-sonnet-5-5 ou claude-haiku-5-5 coûtent moins cher)
ANTHROPIC_MODEL=

# 3. API d'OpenAI, ou tout serveur compatible (Ollama, LM Studio, OpenRouter) avec OPENAI_BASE_URL.
OPENAI_API_KEY=
# Modèle (gpt-5.1 par défaut)
OPENAI_MODEL=
# Adresse de l'API (https://api.openai.com/v1 par défaut)
OPENAI_BASE_URL=

# 4. Abonnement Claude, via Claude Code : le jeton de « claude setup-token » (sk-ant-oat01-…)
CLAUDE_CODE_OAUTH_TOKEN=
# Modèle (sonnet par défaut ; opus, haiku)
CLAUDE_CODE_MODEL=

# 5. Abonnement ChatGPT, via Codex : le contenu de ~/.codex/auth.json. Mieux vaut le coller dans Réglages,
# qui garde la connexion renouvelée.
CODEX_AUTH_JSON=
CODEX_MODEL=
